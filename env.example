"""Checks generated inline buttons and full user-provided catalog without network."""
import importlib.util
import json
import os
from pathlib import Path
import sys
import types
import unittest


# Minimal classes for importing the bot when PTB isn't installed during offline tests.
telegram = types.ModuleType('telegram')
class FakeButton:
    def __init__(self, text, url=None, callback_data=None):
        self.text, self.url, self.callback_data = text, url, callback_data
class FakeMarkup:
    def __init__(self, inline_keyboard):
        self.inline_keyboard = inline_keyboard
telegram.InlineKeyboardButton = FakeButton
telegram.InlineKeyboardMarkup = FakeMarkup
telegram.Update = type('Update', (), {'ALL_TYPES': []})
errors = types.ModuleType('telegram.error')
errors.BadRequest = type('BadRequest', (Exception,), {})
errors.TelegramError = type('TelegramError', (Exception,), {})
ext = types.ModuleType('telegram.ext')
for name in ('Application', 'CallbackQueryHandler', 'CommandHandler'):
    setattr(ext, name, type(name, (), {}))
ext.ContextTypes = type('ContextTypes', (), {'DEFAULT_TYPE': object()})
sys.modules.update({'telegram': telegram, 'telegram.error': errors, 'telegram.ext': ext})
os.environ.setdefault('BOT_TOKEN', 'test:test')
spec = importlib.util.spec_from_file_location('bleach_menu', Path(__file__).resolve().parents[1] / 'main.py')
app = importlib.util.module_from_spec(spec)
spec.loader.exec_module(app)


class ChannelNavigationTests(unittest.TestCase):
    def test_section_counts(self):
        self.assertEqual([len(app.SECTIONS[x]['items']) for x in ('original','tybw')], [10,4])
        self.assertEqual(len(app.ITEMS), 14)

    def test_private_channel_urls(self):
        self.assertEqual(app.channel_post_url(-1003593534577, 317), 'https://t.me/c/3593534577/317')
        with self.assertRaises(ValueError):
            app.channel_post_url(3593534577, 1)

    def test_main_links_are_channel_urls(self):
        buttons = app.hub_keyboard(-1003593534577, {'original': 318, 'tybw': 319}).inline_keyboard
        self.assertEqual([row[0].url for row in buttons], [
            'https://t.me/c/3593534577/318', 'https://t.me/c/3593534577/319'
        ])
        for row in buttons:
            self.assertIsNone(row[0].callback_data)
            self.assertNotIn('?start=', row[0].url)

    def test_archived_links_are_all_buttons(self):
        expected = [23,34,77,96,127,142,150,176,217,241,255,269,284,299]
        actual=[]
        for sid in ('original','tybw'):
            buttons = app.section_keyboard(sid, -1003593534577, 320).inline_keyboard
            actual.extend(int(row[0].url.rsplit('/',1)[1]) for row in buttons[:-1])
            self.assertEqual(buttons[-1][0].url, 'https://t.me/c/3593534577/320')
            for row in buttons:
                self.assertIsNotNone(row[0].url)
                self.assertIsNone(row[0].callback_data)
                self.assertNotIn('?start=', row[0].url)
        self.assertEqual(actual, expected)

    def test_catalog_file_on_disk(self):
        data=json.loads((Path(__file__).resolve().parents[1]/'catalog.json').read_text(encoding='utf-8'))
        self.assertEqual(len(data['sections']),2)
        self.assertEqual(data['invite_link'], 'https://t.me/+gnBXocT0HL40YTRi')


if __name__ == '__main__':
    unittest.main()
