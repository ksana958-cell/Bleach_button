"""Offline tests: python -m unittest discover -s tests -v (no Telegram needed)."""
import json
import unittest
from pathlib import Path
from urllib.parse import urlparse

ROOT = Path(__file__).resolve().parents[1]
CATALOG = json.loads((ROOT / "catalog.json").read_text(encoding="utf-8"))
SECTIONS = CATALOG["sections"]
ORIGINAL = SECTIONS[0]["items"]
TYBW = SECTIONS[1]["items"]
EXPECTED = {
    "substitute": 23,
    "soul_entry": 34,
    "soul_rescue": 77,
    "arrancar": 96,
    "hueco": 127,
    "arrancar_vs": 142,
    "past": 150,
    "karakura": 176,
    "downfall": 217,
    "lost_agent": 241,
    "tybw_amber": 255,
    "tybw_deep": 269,
    "tybw_separation": 284,
    "tybw_conflict": 299,
}


class CatalogTests(unittest.TestCase):
    def test_section_ids(self):
        self.assertEqual([section["id"] for section in SECTIONS], ["original", "tybw"])

    def test_arc_counts(self):
        self.assertEqual(len(ORIGINAL), 10)
        self.assertEqual(len(TYBW), 4)

    def test_unique_ids(self):
        ids = [item["id"] for sec in SECTIONS for item in sec["items"]]
        self.assertEqual(len(ids), len(set(ids)))
        self.assertEqual(set(ids), set(EXPECTED))

    def test_all_post_urls(self):
        for sec in SECTIONS:
            for item in sec["items"]:
                with self.subTest(item=item["id"]):
                    parsed = urlparse(item["url"])
                    self.assertEqual(parsed.scheme, "https")
                    self.assertEqual(parsed.netloc, "t.me")
                    self.assertEqual(parsed.path, f"/c/3593534577/{EXPECTED[item['id']]}")

    def test_invite(self):
        self.assertEqual(CATALOG["invite_link"], "https://t.me/+gnBXocT0HL40YTRi")

    def test_labels(self):
        for sec in SECTIONS:
            self.assertTrue(sec["title"] and sec["button"] and sec["description"])
            for item in sec["items"]:
                self.assertTrue(item["name"] and item["episodes"])

    def test_original_ranges(self):
        self.assertEqual(
            [item["episodes"] for item in ORIGINAL],
            ["1–20", "21–41", "42–63", "110–127", "138–167", "190–203", "206–212", "215–228", "266–310", "343–366"],
        )

    def test_tybw_ranges_match_submitted_posts(self):
        self.assertEqual([item["episodes"] for item in TYBW], ["366–379", "366–379", "380–392", "393–405"])


if __name__ == "__main__":
    unittest.main()
